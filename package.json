{
  "name": "quartz-sop-template",
  "description": "Open-source Quartz template for team SOP and knowledge-base websites",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "author": "cfour contributors",
  "license": "MIT",
  "homepage": "",
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "dev": "node ./quartz/bootstrap-cli.mjs build --serve --port 8081",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "prettier . --write",
    "test": "tsx --test",
    "test:db": "bash scripts/verify-postgres-migrations.sh",
    "test:collab-security": "bash scripts/test-collab-security-postgres.sh",
    "test:browser": "SITE_MODE=static npx quartz build && playwright test",
    "build:showcase": "node scripts/build-showcase.mjs",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "blog",
    "digital-garden",
    "knowledge-base",
    "markdown",
    "quartz",
    "site generator",
    "sop",
    "ssg",
    "supabase",
    "team-docs"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@floating-ui/dom": "^1.7.4",
    "@myriaddreamin/rehype-typst": "^0.6.0",
    "@napi-rs/simple-git": "0.1.22",
    "@supabase/supabase-js": "^2.110.7",
    "@tweenjs/tween.js": "^25.0.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "cli-spinner": "^0.2.10",
    "d3": "^7.9.0",
    "esbuild-sass-plugin": "^3.7.0",
    "flexsearch": "^0.8.205",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "is-absolute-url": "^5.0.0",
    "js-yaml": "^4.3.0",
    "lightningcss": "^1.30.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "micromorph": "^0.4.5",
    "minimatch": "^10.2.5",
    "pixi.js": "^8.19.0",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.6.3",
    "pretty-bytes": "^7.1.0",
    "pretty-time": "^1.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-mathjax": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "rfdc": "^1.4.1",
    "satori": "^0.18.3",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.5",
    "shiki": "^1.26.2",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "toml": "^5.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.1",
    "ws": "^8.21.1",
    "yargs": "^18.0.0"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
